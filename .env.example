# Copy to .env before running the app or the benchmark.
#
#   cp .env.example .env
#
# .env is gitignored, .env.example is the checked-in reference.

# ========================================
# Database
# ========================================

# Inside docker compose the API talks to the postgres service directly.
DATABASE_URL=postgres://eventflow:eventflow@postgres:5432/eventflow?sslmode=disable

# Running the API or ./cmd/outboxbench from the host instead, use the
# published port from docker-compose.yml:
# DATABASE_URL=postgres://eventflow:eventflow@localhost:5452/eventflow?sslmode=disable

# Each outbox worker holds one pooled connection for the length of its
# claim transaction, so keep DB_MAX_CONNS comfortably above OUTBOX_WORKERS
# or the workers queue on connection acquisition instead of on Postgres.
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m

# ========================================
# Outbox worker
# ========================================

# Number of workers in the process. Events are never split between them:
# every worker calls ClaimPending and Postgres arbitrates through
# FOR UPDATE SKIP LOCKED. Overridden by docker-compose.yml, which reads the
# OUTBOX_WORKERS shell variable and defaults to 1.
OUTBOX_WORKERS=1

# Events claimed per ClaimPending call.
OUTBOX_BATCH_SIZE=10

# How often each worker polls. Throughput is capped at
# workers x batch_size / interval, so at 5s a single worker with batch 10
# cannot exceed 2 events/sec no matter how fast Postgres is.
OUTBOX_INTERVAL=5s

# How long an event may sit in PROCESSING before any worker reclaims it
# back to PENDING. This is the crash-recovery path: a worker killed
# mid-batch leaves its rows in PROCESSING and this timeout frees them.
# Keep it well above SHUTDOWN_TIMEOUT plus the slowest realistic publish,
# or rows still being worked on get reclaimed and published twice.
OUTBOX_STALE_TIMEOUT=5m

# Chaos knob: probability in [0, 1) that a publish attempt fails, to
# exercise retry/backoff and recovery. Leave at 0 outside failure drills.
PUBLISH_FAILURE_RATE=0

# ========================================
# Shutdown
# ========================================

# How long a worker may keep draining in-flight work after the shutdown
# signal before it is force-canceled.
SHUTDOWN_TIMEOUT=30s
